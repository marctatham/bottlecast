rules_version = '2';

// BottleCast's Cloud Firestore security rules.
//
// Collections: messages, finds, daily, reports, handoffs, castTally, claims, streakDays, deletions,
// users, users/{uid}/blockedWriters, and users/{uid}/wallets and walletIndex, which only the Worker
// writes. Anything else is denied, because rules deny by default: minter, the Worker's own state, is
// one of those. The Worker signs in as a service account, which these rules don't apply to. Tests:
// firebase/test, run with `npm run test:emulator`.
//
// The report threshold (3) also lives in the app's sea queries (reportCount in [0, 1, 2]), the Terms
// version in the app's TERMS_VERSION and the daily casts in its CASTS_PER_DAY, so change each pair
// together. Access calls (get, getAfter, exists) go last in each && chain and never in a let, which
// is evaluated eagerly.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Who is asking ----------

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return request.auth.uid;
    }

    // A Google identity on the account: a Google sign-in, or a guest that linked Google. A linked
    // guest's token can still name 'anonymous' as its sign-in provider, so the identities decide.
    function hasGoogle() {
      return signedIn()
        && 'google.com' in request.auth.token.get('firebase', {}).get('identities', {});
    }

    // A custom claim, set per project by scripts/set_admin_claim.py.
    function isAdmin() {
      return signedIn() && request.auth.token.get('admin', false) == true;
    }

    // ---------- Helpers ----------

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function changedKeys() {
      return incoming().diff(existing()).affectedKeys();
    }

    function hasExactly(keys) {
      return incoming().keys().hasAll(keys) && incoming().keys().hasOnly(keys);
    }

    // A find and a report share one id: "{messageId}_{uid}".
    function pairId(messageId) {
      return messageId + '_' + me();
    }

    function messageDoc(messageId) {
      return /databases/$(database)/documents/messages/$(messageId);
    }

    function findDoc(findId) {
      return /databases/$(database)/documents/finds/$(findId);
    }

    function dailyDoc(dailyId) {
      return /databases/$(database)/documents/daily/$(dailyId);
    }

    function reportDoc(reportId) {
      return /databases/$(database)/documents/reports/$(reportId);
    }

    function handoffDoc(messageId) {
      return /databases/$(database)/documents/handoffs/$(messageId);
    }

    function castTallyDoc(uid) {
      return /databases/$(database)/documents/castTally/$(uid);
    }

    function userDoc(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function claimDoc(messageId) {
      return /databases/$(database)/documents/claims/$(messageId);
    }

    function deletionDoc(uid) {
      return /databases/$(database)/documents/deletions/$(uid);
    }

    function walletDoc(uid, address) {
      return /databases/$(database)/documents/users/$(uid)/wallets/$(address);
    }

    // My account is being deleted (spec §3.17): it can't find or cast any more, and may delete the
    // records that are otherwise kept for good.
    function isDeleting() {
      return exists(deletionDoc(me()));
    }

    // The Terms version a cast needs (the app's TERMS_VERSION).
    function currentTermsVersion() {
      return 1;
    }

    // The most casts one local date allows, spec §3.4 (the app's CASTS_PER_DAY).
    function castsPerDay() {
      return 5;
    }

    // 3 to 20 characters with no space at either end, spec §3.2.
    function isPenName(name) {
      return name is string && name.size() >= 3 && name.size() <= 20 && name.trim() == name;
    }

    // ---------- messages/{messageId} ----------

    // In the sea: drifting, or found (a live or an expired hold), and reported fewer than 3 times.
    function isInSea(m) {
      return m.status in ['afloat', 'found'] && m.reportCount < 3;
    }

    // A find holds the bottle for 7 days. The end is computed here, never stored or swept.
    function holdEnds(m) {
      return m.foundAt + duration.value(7, 'd');
    }

    function holdIsLive(m) {
      return m.status == 'found' && request.time < holdEnds(m);
    }

    // A live hold, including one on a bottle whose writer deleted their account while it was held
    // (orphaned): its finder can still keep it, report it or hand it over, but it never drifts again.
    function isHeld(m) {
      return m.status in ['found', 'orphaned'] && request.time < holdEnds(m);
    }

    // An orphan someone still holds, which they can read like a bottle in the sea.
    function isLiveOrphan(m) {
      return m.status == 'orphaned' && m.reportCount < 3 && request.time < holdEnds(m);
    }

    function isFindable(m) {
      return m.reportCount < 3
        && (m.status == 'afloat' || (m.status == 'found' && request.time >= holdEnds(m)));
    }

    // A cast needs a Google identity, the current Terms on my profile and my cast tally counting it,
    // both as this commit leaves them. A pen name must be my profile's own (spec §3.4, §3.4b).
    function isValidCast(messageId) {
      let m = incoming();
      return hasGoogle()
        && hasExactly(['id', 'messageContent', 'userId', 'createdAt', 'lang', 'status',
                       'rand', 'penName', 'sealable', 'reportCount', 'findCount', 'foundAt'])
        && messageId.matches('^[A-Za-z0-9]{20}$')
        && m.id == messageId
        && m.messageContent is string
        && m.messageContent.trim().size() >= 10
        && m.messageContent.toUtf8().size() <= 280
        && m.userId == me()
        && m.createdAt == request.time
        && m.lang is string && m.lang.matches('^[a-z]{2,3}(-[A-Za-z0-9]{1,8})*$')
        && m.status == 'afloat'
        && m.rand is float && m.rand >= 0 && m.rand < 1
        && m.sealable is bool
        && m.reportCount is int && m.reportCount == 0
        && m.findCount is int && m.findCount == 0
        && m.foundAt == null
        && (m.penName == null || isPenName(m.penName))
        && getAfter(castTallyDoc(me())).data.messageId == messageId
        && getAfter(userDoc(me())).data.get('termsVersion', 0) >= currentTermsVersion()
        && (m.penName == null || getAfter(userDoc(me())).data.get('penName', null) == m.penName)
        && !isDeleting();
    }

    // The pop: one commit holds the bottle and creates my find and today's daily record.
    function isFind(messageId) {
      let before = existing();
      let after = incoming();
      return before.userId != me()
        && isFindable(before)
        && changedKeys().hasOnly(['status', 'findCount', 'foundAt'])
        && after.status == 'found'
        && after.foundAt == request.time
        && after.findCount == before.findCount + 1
        // Finds are create-only and stamped with the commit's time, so this proves "created now".
        && getAfter(findDoc(pairId(messageId))).data.foundAt == request.time;
    }

    // Throw back: the live hold is mine (my find has its foundAt), and my find says so.
    function isThrowBack(messageId) {
      let before = existing();
      let after = incoming();
      return holdIsLive(before)
        && changedKeys().hasOnly(['status', 'foundAt'])
        && after.status == 'afloat'
        && after.foundAt == null
        && getAfter(findDoc(pairId(messageId))).data.foundAt == before.foundAt
        && getAfter(findDoc(pairId(messageId))).data.status == 'thrown_back';
    }

    // Report: one more, from the live holder, with my report and my reported find in the same
    // commit. A reported find can't be thrown back, so each report keeps the bottle out of the sea
    // for the rest of its 7-day hold.
    function isReport(messageId) {
      let before = existing();
      return changedKeys().hasOnly(['reportCount'])
        && incoming().reportCount == before.reportCount + 1
        && isHeld(before)
        && getAfter(findDoc(pairId(messageId))).data.foundAt == before.foundAt
        && getAfter(findDoc(pairId(messageId))).data.status == 'reported'
        && getAfter(reportDoc(pairId(messageId))).data.createdAt == request.time;
    }

    // Keep (spec §1.7): the live holder, signed in with Google, keeps the bottle. One commit marks the
    // bottle kept for good, marks my find kept and creates my claim. Matching my find's foundAt to the
    // bottle's proves the hold is mine: a guest's find left behind by a handover keeps an older one.
    function isKeep(messageId) {
      let before = existing();
      let after = incoming();
      return hasGoogle()
        && isHeld(before)
        && changedKeys().hasOnly(['status', 'keptAt'])
        && after.status == 'kept'
        && after.keptAt == request.time
        && getAfter(findDoc(pairId(messageId))).data.foundAt == before.foundAt
        && getAfter(findDoc(pairId(messageId))).data.status == 'kept'
        && getAfter(claimDoc(messageId)).data.keeperUid == me();
    }

    // A bottle someone kept carries keptAt for good, so the rules know without reading its claim. A
    // sealed one also carries sealedAt, which only the Worker writes: no rule here lets a client set it.
    function wasKept(m) {
      return m.get('keptAt', null) != null;
    }

    // My kept bottle, while it's kept or under review. A removed one stays unreadable, even to me.
    function isMyKept(messageId, m) {
      return m.status in ['kept', 'under_review']
        && wasKept(m)
        && get(claimDoc(messageId)).data.keeperUid == me();
    }

    // A finder's hold that hasn't run out, whatever the bottle's status: pulling a bottle keeps its
    // foundAt, so the finder's hold carries on if it's restored.
    function holdRunning(m) {
      return m.foundAt != null && request.time < holdEnds(m);
    }

    // Moderation: pull a bottle (under_review) or remove it, keeping its hold time, or restore it.
    // Restoring puts it back in the sea, or, while a finder's hold runs, back to that finder with its
    // reports cleared, so it never has two holders. A kept bottle only ever goes back to its keeper,
    // and one whose writer deleted their account never goes back to the sea.
    function isModeration() {
      let before = existing();
      let after = incoming();
      return isAdmin()
        && changedKeys().hasOnly(['status', 'reportCount', 'foundAt'])
        && after.status in ['afloat', 'found', 'kept', 'orphaned', 'under_review', 'removed']
        && after.reportCount is int && after.reportCount >= 0
        && ((wasKept(before) && after.status in ['kept', 'under_review', 'removed'])
            || (!wasKept(before) && before.userId == null && after.status in ['orphaned', 'under_review', 'removed'])
            || (!wasKept(before) && before.userId != null && !(after.status in ['kept', 'orphaned'])))
        && (after.status != 'orphaned' || holdRunning(before))
        && ((after.status == 'afloat' && after.foundAt == null && !holdRunning(before))
            || (after.status != 'afloat' && after.foundAt == before.foundAt))
        && (after.status != 'found' || holdRunning(before));
    }

    // Deleting an account (spec §3.17, decided 2026-10-15): a bottle someone else holds or kept stays
    // with them, with the writer's uid and pen name taken off. A held one becomes orphaned, so it never
    // drifts again. Nothing else changes, and no access call is made, so a batch can hold hundreds.
    function isAnonymise() {
      let before = existing();
      let after = incoming();
      return before.userId == me()
        && changedKeys().hasOnly(['userId', 'penName', 'status'])
        && after.userId == null
        && after.penName == null
        && (holdRunning(before) || wasKept(before))
        && ((before.status == 'found' && after.status == 'orphaned')
            || (before.status != 'found' && after.status == before.status));
    }

    // Handover (spec §3.2): a guest who signs in to a Google account that already exists hands today's
    // live hold to it. The handoff the guest left is claimed in this commit with the token only its
    // phone knew, and my new find holds the bottle from now. The guest's find keeps the old foundAt,
    // so it no longer holds the bottle. The find count stays: nobody new found it.
    function isHandover(messageId) {
      let before = existing();
      return before.userId != me()
        && isHeld(before)
        && changedKeys().hasOnly(['foundAt'])
        && incoming().foundAt == request.time
        && getAfter(handoffDoc(messageId)).data.claimedBy == me()
        && getAfter(handoffDoc(messageId)).data.claimedAt == request.time
        && get(findDoc(messageId + '_' + getAfter(handoffDoc(messageId)).data.from)).data.status == 'held'
        && get(findDoc(messageId + '_' + getAfter(handoffDoc(messageId)).data.from)).data.foundAt
             == before.foundAt
        && getAfter(findDoc(pairId(messageId))).data.foundAt == request.time;
    }

    match /messages/{messageId} {
      allow get: if signedIn()
        && (resource == null
            || isAdmin()
            || resource.data.userId == me()
            || isInSea(resource.data)
            || isLiveOrphan(resource.data)
            || isMyKept(messageId, resource.data));
      allow list: if signedIn()
        && (isAdmin()
            || resource.data.userId == me()
            || (request.query.limit <= 20 && isInSea(resource.data)));
      allow create: if signedIn() && isValidCast(messageId);
      allow update: if signedIn()
        && (isFind(messageId) || isThrowBack(messageId) || isReport(messageId) || isModeration()
            || isHandover(messageId) || isKeep(messageId) || isAnonymise());
      // The writer may pull a bottle while it drifts, so no one finds it (spec §3.11). One that's held,
      // kept or reported out of the sea stays, so nobody loses a bottle or dodges a review, until the
      // writer deletes their account: then only a held or kept one stays, anonymised.
      allow delete: if isAdmin()
        || (signedIn() && resource.data.userId == me()
            && (isFindable(resource.data)
                || (!holdRunning(resource.data) && !wasKept(resource.data) && isDeleting())));
    }

    // ---------- finds/{messageId}_{finderUid} ----------

    function isValidFind(findId) {
      let f = incoming();
      return hasExactly(['messageId', 'finderUid', 'foundAt', 'dailyId', 'status'])
        && f.finderUid == me()
        && f.messageId is string
        && findId == pairId(f.messageId)
        && f.status == 'held'
        && f.foundAt == request.time
        && f.dailyId is string
        && f.dailyId.matches('^' + me() + '_[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        // Today's daily record, created in this commit, names this bottle...
        && getAfter(dailyDoc(f.dailyId)).data.foundAt == request.time
        && getAfter(dailyDoc(f.dailyId)).data.messageId == f.messageId
        // ...and the bottle was held in this commit, so a find always means a real hold.
        && getAfter(messageDoc(f.messageId)).data.status == 'found'
        && getAfter(messageDoc(f.messageId)).data.foundAt == request.time;
    }

    function isFindStatusChange(findId) {
      let after = incoming();
      return changedKeys().hasOnly(['status'])
        && existing().status == 'held'
        && (after.status == 'thrown_back'
            || (after.status == 'reported'
                && getAfter(reportDoc(findId)).data.createdAt == request.time)
            || (after.status == 'kept'
                && getAfter(claimDoc(existing().messageId)).data.keeperUid == me()
                && getAfter(claimDoc(existing().messageId)).data.keptAt == request.time));
    }

    match /finds/{findId} {
      // By id, so the find's transaction can read my find before it exists.
      allow get: if signedIn() && findId.matches('^.+_' + me() + '$');
      allow list: if signedIn() && resource.data.finderUid == me();
      allow create: if signedIn() && isValidFind(findId);
      allow update: if signedIn() && resource.data.finderUid == me() && isFindStatusChange(findId);
      // A find is forever, so nobody finds the same bottle twice, until its finder deletes their account.
      allow delete: if signedIn() && resource.data.finderUid == me() && isDeleting();
    }

    // ---------- daily/{uid}_{yyyy-MM-dd} ----------

    // A date that is today somewhere on Earth right now, from UTC-12 to UTC+14. The round trip
    // through timestamp.date() rejects dates that don't exist, such as 2026-02-30.
    function isLocalDateNow(dateString) {
      let parts = dateString.split('-');
      let day = timestamp.date(int(parts[0]), int(parts[1]), int(parts[2]));
      return dateString.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && day.year() == int(parts[0])
        && day.month() == int(parts[1])
        && day.day() == int(parts[2])
        && day >= (request.time - duration.value(12, 'h')).date()
        && day <= (request.time + duration.value(14, 'h')).date();
    }

    function isValidDaily(dailyId) {
      let d = incoming();
      return hasExactly(['uid', 'date', 'zone', 'messageId', 'foundAt'])
        && d.uid == me()
        && d.date is string
        && dailyId == me() + '_' + d.date
        && isLocalDateNow(d.date)
        && d.zone is string && d.zone.size() > 0 && d.zone.size() <= 64
        && d.messageId is string
        && d.foundAt == request.time
        && getAfter(findDoc(pairId(d.messageId))).data.foundAt == request.time
        && !isDeleting();
    }

    match /daily/{dailyId} {
      allow get: if signedIn() && dailyId.matches('^' + me() + '_.+$');
      allow list: if signedIn() && resource.data.uid == me();
      allow create: if signedIn() && isValidDaily(dailyId);
      // Create-only, so there is one find per local date, until the account is being deleted, when
      // it can't find any more.
      allow delete: if signedIn() && resource.data.uid == me() && isDeleting();
    }

    // ---------- reports/{messageId}_{reporterUid} ----------

    function isValidReport(reportId) {
      let r = incoming();
      return hasExactly(['messageId', 'reporterUid', 'reason', 'blockedWriter', 'createdAt'])
        && r.reporterUid == me()
        && r.messageId is string
        && reportId == pairId(r.messageId)
        && (r.reason == null || r.reason in ['hurtful', 'sexual', 'personal_info', 'spam', 'other'])
        && r.blockedWriter is bool
        && r.createdAt == request.time
        // Counted in the same commit, so the message's report rule (a live hold, my find) applies.
        && getAfter(messageDoc(r.messageId)).data.reportCount
             == get(messageDoc(r.messageId)).data.reportCount + 1;
    }

    match /reports/{reportId} {
      allow get: if isAdmin() || (signedIn() && reportId.matches('^.+_' + me() + '$'));
      allow list, delete: if isAdmin();
      allow create: if signedIn() && isValidReport(reportId);
    }

    // ---------- handoffs/{messageId} ----------

    // Only today's live holder, as a guest, may hand its bottle over. tokenHash is the SHA-256 of a
    // random token kept only in that phone's memory. Arming again replaces an older handoff.
    function isValidHandoff(messageId) {
      let h = incoming();
      return !hasGoogle()
        && hasExactly(['from', 'date', 'tokenHash', 'createdAt', 'token', 'claimedBy', 'claimedAt'])
        && h.from == me()
        && h.date is string && isLocalDateNow(h.date)
        && h.tokenHash is bytes && h.tokenHash.size() == 32
        && h.createdAt == request.time
        && h.token == null && h.claimedBy == null && h.claimedAt == null
        && get(dailyDoc(me() + '_' + h.date)).data.messageId == messageId
        && get(findDoc(pairId(messageId))).data.status == 'held'
        && get(findDoc(pairId(messageId))).data.foundAt == get(messageDoc(messageId)).data.foundAt
        && isHeld(get(messageDoc(messageId)).data);
    }

    // The claim: once, within 10 minutes, by a Google account other than the guest, presenting the
    // token whose hash the guest left. The bottle moves to me in the same commit (isHandover).
    function isHandoffClaim(messageId) {
      let before = existing();
      let after = incoming();
      return hasGoogle()
        && before.from != me()
        && before.claimedBy == null
        && request.time < before.createdAt + duration.value(10, 'm')
        && changedKeys().hasOnly(['token', 'claimedBy', 'claimedAt'])
        && after.token is string && after.token.size() <= 64
        && hashing.sha256(after.token) == before.tokenHash
        && after.claimedBy == me()
        && after.claimedAt == request.time
        && getAfter(messageDoc(messageId)).data.foundAt == request.time;
    }

    match /handoffs/{messageId} {
      // No reads at all, so nobody can learn a hash, a token, or who handed what to whom.
      allow create: if signedIn() && isValidHandoff(messageId);
      allow update: if signedIn() && (isValidHandoff(messageId) || isHandoffClaim(messageId));
    }

    // ---------- castTally/{uid} ----------

    // Each cast counts on its writer's tally in the same commit, at most castsPerDay() on a local date.
    // The date only moves forward, so going back a day can't reset the count.
    function isTally(userId) {
      let t = incoming();
      return me() == userId
        && hasExactly(['date', 'count', 'messageId'])
        && t.date is string && isLocalDateNow(t.date)
        && t.count is int && t.count >= 1 && t.count <= castsPerDay()
        && t.messageId is string;
    }

    // The tally names a bottle of mine, created in this commit.
    function countsMyCast() {
      return getAfter(messageDoc(incoming().messageId)).data.userId == me()
        && getAfter(messageDoc(incoming().messageId)).data.createdAt == request.time;
    }

    match /castTally/{userId} {
      allow get: if signedIn() && me() == userId;
      allow create: if signedIn() && isTally(userId) && incoming().count == 1 && countsMyCast();
      allow update: if signedIn() && isTally(userId)
        && ((incoming().date == existing().date && incoming().count == existing().count + 1)
            || (incoming().date > existing().date && incoming().count == 1))
        && countsMyCast();
      allow delete: if signedIn() && me() == userId && isDeleting();
    }

    // ---------- claims/{messageId} ----------

    // Kept (spec §1.7): my claim on a bottle, made in the keep's commit, which leaves it pending_wallet.
    function isValidClaim(messageId) {
      let c = incoming();
      return hasGoogle()
        && hasExactly(['messageId', 'keeperUid', 'status', 'keptAt'])
        && c.messageId == messageId
        && c.keeperUid == me()
        && c.status == 'pending_wallet'
        && c.keptAt == request.time
        && getAfter(messageDoc(messageId)).data.status == 'kept'
        && getAfter(messageDoc(messageId)).data.keptAt == request.time;
    }

    // Asking to seal (spec §1.7, decided 2026-10-18): I move my claim from pending_wallet, or from
    // failed to try again, to cooling. It names one of my linked wallets and the end of the 24-hour
    // safety check, counted from the cast, and drops a failed seal's error. The bottle must still be
    // kept and sealable, and still have its writer: once a writer has deleted their account, nobody
    // can ask to seal their bottles. Every later status is the Worker's.
    function isAskToSeal(messageId) {
      let before = existing();
      let after = incoming();
      return hasGoogle()
        && before.keeperUid == me()
        && before.status in ['pending_wallet', 'failed']
        && changedKeys().hasOnly(['status', 'sealAfter', 'to', 'error'])
        && after.status == 'cooling'
        && !('error' in after)
        && after.to is string && after.to.matches('^0x[0-9a-f]{40}$')
        && after.sealAfter is timestamp
        && after.sealAfter == get(messageDoc(messageId)).data.createdAt + duration.value(24, 'h')
        && get(messageDoc(messageId)).data.status == 'kept'
        && get(messageDoc(messageId)).data.sealable == true
        && get(messageDoc(messageId)).data.userId != null
        && exists(walletDoc(me(), after.to))
        && !isDeleting();
    }

    match /claims/{messageId} {
      allow get: if isAdmin() || (signedIn() && resource.data.keeperUid == me());
      allow list: if isAdmin() || (signedIn() && resource.data.keeperUid == me());
      allow create: if signedIn() && isValidClaim(messageId);
      allow update: if signedIn() && isAskToSeal(messageId);
      // Only as the keeper's account is deleted, and only a claim that isn't sealing: one that's
      // cooling or minting finishes, and the Worker deletes it then.
      allow delete: if signedIn() && resource.data.keeperUid == me()
        && resource.data.status in ['pending_wallet', 'failed', 'minted']
        && isDeleting();
    }

    // ---------- streakDays/{uid}_{yyyy-MM-dd} ----------

    // What a local date did for my streak besides a find (spec §3.3): my first cast that day gave a
    // calm-sea shield, the sea was calm when I looked, or a guest's streak was carried over. Writes
    // merge, marks only ever turn true, and a carried streak only grows. The rules can't see a calm
    // sea or check a carried streak, so the app is trusted with those until a Worker takes over.
    function isValidStreakDay(dayId) {
      let d = incoming();
      return d.keys().hasAll(['uid', 'date'])
        && d.keys().hasOnly(['uid', 'date', 'cast', 'calm', 'carried'])
        && d.uid == me()
        && d.date is string
        && dayId == me() + '_' + d.date
        && isLocalDateNow(d.date)
        && d.get('cast', true) == true
        && d.get('calm', true) == true
        && (!('carried' in d) || (d.carried is int && d.carried >= 1 && d.carried <= 3650));
    }

    // A cast mark needs this commit to start my cast tally on that date: the day's first cast.
    function startsMyCastDay(date) {
      return getAfter(castTallyDoc(me())).data.date == date
        && getAfter(castTallyDoc(me())).data.count == 1;
    }

    match /streakDays/{dayId} {
      allow get: if signedIn() && dayId.matches('^' + me() + '_.+$');
      allow list: if signedIn() && resource.data.uid == me();
      allow create: if signedIn() && isValidStreakDay(dayId)
        && (!('cast' in incoming()) || startsMyCastDay(incoming().date));
      allow update: if signedIn() && isValidStreakDay(dayId)
        && incoming().keys().hasAll(existing().keys())
        && incoming().get('carried', 0) >= existing().get('carried', 0)
        && ('cast' in existing() || !('cast' in incoming()) || startsMyCastDay(incoming().date));
      allow delete: if signedIn() && resource.data.uid == me() && isDeleting();
    }

    // ---------- deletions/{uid} ----------

    // The tombstone of an account being deleted (spec §3.17), made once the user has signed in again
    // and never removed. While it exists the account can't find or cast, and may delete its records,
    // so a deletion that stops part-way carries on where it stopped.
    match /deletions/{userId} {
      allow get: if signedIn() && me() == userId;
      allow create: if signedIn() && me() == userId && hasGoogle()
        && hasExactly(['createdAt']) && incoming().createdAt == request.time;
    }

    // ---------- users/{uid} ----------

    // My profile: a pen name, and which Terms I accepted and when. Writes merge, so a key may be
    // missing. Only Google accounts have one.
    function isValidProfile(userId) {
      let u = incoming();
      return me() == userId
        && hasGoogle()
        && u.keys().hasOnly(['penName', 'termsVersion', 'termsAcceptedAt'])
        && (!('penName' in u) || u.penName == null || isPenName(u.penName))
        && (('termsVersion' in u) == ('termsAcceptedAt' in u))
        && (!('termsVersion' in u) || (u.termsVersion is int && u.termsVersion >= 1));
    }

    // Accepting stamps the commit's time at a version no older than before. The same version again
    // is allowed: offline, the app may not know it already accepted.
    function acceptsTerms(previousVersion) {
      return incoming().termsVersion >= previousVersion && incoming().termsAcceptedAt == request.time;
    }

    function keepsTerms() {
      return incoming().get('termsVersion', null) == existing().get('termsVersion', null)
        && incoming().get('termsAcceptedAt', null) == existing().get('termsAcceptedAt', null);
    }

    match /users/{userId} {
      allow get: if signedIn() && me() == userId;
      allow create: if signedIn() && isValidProfile(userId)
        && (!('termsVersion' in incoming()) || acceptsTerms(1));
      allow update: if signedIn() && isValidProfile(userId)
        && (keepsTerms()
            || ('termsVersion' in incoming() && acceptsTerms(existing().get('termsVersion', 1))));
      allow delete: if signedIn() && me() == userId && isDeleting();
    }

    // ---------- users/{uid}/blockedWriters/{writerUid} ----------

    match /users/{userId}/blockedWriters/{writerUid} {
      allow read, delete: if signedIn() && me() == userId;
      allow create, update: if signedIn() && me() == userId
        && writerUid != userId
        && hasExactly(['at', 'messageId'])
        && incoming().at == request.time
        && incoming().messageId is string;
    }

    // ---------- users/{uid}/wallets/{address} and walletIndex/{address} ----------

    // A wallet linked to my account (spec §1.7, §3.9), keyed by its lowercase address, and the index
    // that maps an address to the one account holding it. Only the Worker writes either, once the
    // wallet has signed (/wallet/link). I may read mine, and delete them as my account is deleted.
    match /users/{userId}/wallets/{address} {
      allow read: if signedIn() && me() == userId;
      allow delete: if signedIn() && me() == userId && isDeleting();
    }

    match /walletIndex/{address} {
      allow get, list: if signedIn() && resource.data.uid == me();
      // An entry that's already gone counts too, so a deletion that stopped part-way carries on.
      allow delete: if signedIn() && (resource == null || resource.data.uid == me()) && isDeleting();
    }
  }
}
