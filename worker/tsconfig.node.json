// The Node side: the tests, the bench, the local end-to-end run and the deploy scripts. They import src/, so every module
// there but index.ts keeps to types Node has too (config.ts's KeyValueCache stands in for KV).
{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024", "dom"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true
  },
  "include": ["test", "bench", "e2e", "scripts", "vitest.config.ts"]
}
